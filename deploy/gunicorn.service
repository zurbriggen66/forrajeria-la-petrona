# Servidor de aplicación de Django. Escucha sólo en loopback: nginx es el
# único que le habla.
#
#   sudo cp deploy/gunicorn.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gunicorn

[Unit]
Description=Gunicorn — ERP Forrajeria La Petrona
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=petrona
Group=www-data
WorkingDirectory=/home/petrona/app/backend
ExecStart=/home/petrona/app/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    config.wsgi:application
Restart=always
RestartSec=5

# El proceso sólo necesita escribir en staticfiles/ y leer los certificados.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
